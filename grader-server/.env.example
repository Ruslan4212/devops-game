# Какой ИИ проверяет ответы. Достаточно ОДНОГО ключа — берётся первый заданный.
# Все, кроме Anthropic, бесплатны и для учебной игры их лимитов хватает с запасом.

# Groq — рекомендую: бесплатно, очень быстро, хорошо знает русский
# ключ: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini — бесплатный тариф
# ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter — есть бесплатные модели (модели с суффиксом :free)
# ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Anthropic — платный, нужен пополненный баланс
ANTHROPIC_API_KEY=

# Кому разрешено обращаться к проверке (через запятую, без пробелов)
ALLOWED_ORIGINS=https://ruslan4212.github.io,http://localhost:5173
