# Скопируйте в .env и заполните.

# Ключ с console.anthropic.com — платный, держите только здесь, никогда не кладите в код игры.
ANTHROPIC_API_KEY=sk-ant-...

# Через запятую — origin'ы, которым разрешено дёргать проверку.
# Защищает от того, что кто-то чужой начнёт тратить ваш платный ключ.
ALLOWED_ORIGINS=https://ruslan4212.github.io,http://localhost:5173

# Необязательное (по умолчанию — быстрая и дешёвая модель, для короткой проверки этого достаточно):
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
