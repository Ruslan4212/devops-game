    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0"
  }
