# Скопируйте в .env и заполните. Те же значения, что VITE_SUPABASE_* у клиента.
# SUPABASE_ANON_KEY публичен по дизайну Supabase, но в примере — только плейсхолдер.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Через запятую — origin'ы, которым разрешено подключаться к песочнице.
# Защищает от использования вашего сервера чужими сайтами с украденным токеном.
ALLOWED_ORIGINS=https://ruslan4212.github.io,http://localhost:5173

# Необязательное (значения по умолчанию заданы в server.js):
# SANDBOX_IMAGE=opsacademy-sandbox:1   (соберите из sandbox.Dockerfile)
# SANDBOX_MAX_MINUTES=15
# SANDBOX_MAX_CONCURRENT=5
# SANDBOX_MEM=128m
# SANDBOX_CPUS=0.3
# SANDBOX_PIDS=64
