# Синхронизация прогресса между устройствами (Supabase). Без этих переменных
# приложение работает как раньше — прогресс в localStorage.
#
# 1. supabase.com -> новый проект (бесплатно)
# 2. SQL Editor -> вставить supabase_schema.sql -> Run
# 3. Project Settings -> API -> скопировать Project URL и anon public key сюда
# 4. (для входа без письма) Authentication -> Providers -> Email -> off "Confirm email"
#
# anon-ключ публичен по дизайну Supabase — его можно коммитить. Вся защита
# данных на RLS-политиках из supabase_schema.sql. Service role key НЕ используется
# и НЕ должен попадать в клиентский .env.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Капстоун на реальном сервере (sandbox-server). Без переменной финальная
# миссия предлагает внешние бесплатные песочницы вместо своего сервера.
VITE_SANDBOX_URL=
